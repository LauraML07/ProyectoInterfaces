   <Label fx:id="welcomeText11111" layoutX="104.0" layoutY="790.0" text="Ir a la tabla">
      <font>
         <Font size="14.0" />
      </font>
      <VBox.margin>
         <Insets top="10.0" />
      </VBox.margin>
   </Label>
   <Button mnemonicParsing="false" onAction="#onIrTablaButtonClick" style="-fx-background-color: #616161; -fx-text-fill: white;" text="Ir a la tabla" />
   <stylesheets>
      <URL value="@../../../css/style.css" />
   </stylesheets>
</VBox>
